{
  "version": 2,
  "framework": null,
  "builds": [
    {
      "src": "api/*.php",
      "use": "now-php@1.0.0"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/backend/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/purchase-orders.html",
      "dest": "/purchase-orders.html"
    },
    {
      "src": "/purchase-order-form.html",
      "dest": "/purchase-order-form.html"
    },
    {
      "src": "/suppliers.html",
      "dest": "/suppliers.html"
    },
    {
      "src": "/items.html",
      "dest": "/items.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
