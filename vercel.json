{
  "version": 2,
  "builds": [
    {
      "src": "api/*.php",
      "use": "vercel-php@0.7.1"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/backend/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/index.html",
      "dest": "/index.html"
    },
    {
      "src": "/purchase-orders.html",
      "dest": "/purchase-orders.html"
    },
    {
      "src": "/purchase-order-form.html",
      "dest": "/purchase-order-form.html"
    },
    {
      "src": "/suppliers.html",
      "dest": "/suppliers.html"
    },
    {
      "src": "/items.html",
      "dest": "/items.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    }
  ]
}
